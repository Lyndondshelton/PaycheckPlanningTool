{
  "name": "paycheck-planning-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node-pg-migrate up --config-file lib/db/migrations.config.json --envPath .env.local",
    "db:migrate:preview": "npm run db:migrate -- --dry-run",
    "db:migrate:create": "node-pg-migrate create --config-file lib/db/migrations.config.json --envPath .env.local"
  },
  "dependencies": {
    "better-auth": "^1.7.14",
    "next": "16.4.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "node-pg-migrate": "^9.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
